PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/Social_media
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:3000

# Automatic removal of unused uploads (replaced profile pictures, deleted posts)
AUTO_CLEANUP=true
CLEANUP_INTERVAL_HOURS=24

# Backblaze B2 storage for uploads (recommended in production; leave blank locally to use the Uploads/ folders)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# S3 endpoint shown on the bucket page, e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
# Optional: only if you use a custom domain in front of the bucket
B2_PUBLIC_URL=
